# ──────────────── Phase 1 (infrastructure — 8 vars) ────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
DATABASE_POOL_URL=postgres://postgres:postgres@localhost:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=DUMMY-CHANGE-ME
SUPABASE_SERVICE_ROLE_KEY=DUMMY-CHANGE-ME
SUPABASE_PROJECT_REF=DUMMY-CHANGE-ME
SUPABASE_ACCESS_TOKEN=DUMMY-CHANGE-ME
IDENTIFICATION_PROVIDER_MODE=stub

# ──────────────── Phase 1 (observability — 6 vars; CI only, mostly empty) ────────────────
# Empty values intentionally. D-19/D-20: Sentry and PostHog disabled locally.
# EXCEPTION: NEXT_PUBLIC_POSTHOG_HOST is a public non-secret constant — hardcoded to reduce drift.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ──────────────── Phase 4 (Inngest — verification email is the first async consumer) ────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_DEV=1 forces the Inngest SDK into dev mode regardless of NODE_ENV.
# `pnpm dev` already sets this in the npm script (mirrors playwright.config.ts).
# Set it manually here ONLY if you run the app via `next start` locally without
# a real INNGEST_EVENT_KEY — otherwise the SDK tries to deliver to inngest.com
# with whatever placeholder INNGEST_EVENT_KEY value is set, retries 5× with
# exponential backoff (~3s), then throws and 500s every signup / resend /
# password-reset request. See .planning/debug/signup-route-500.md for the
# full diagnosis. Production deployments set a real INNGEST_EVENT_KEY instead.
INNGEST_DEV=

# ──────────────── Phase 4 (Resend transactional email) ────────────────
# Empty in local dev → adapter logs a sanitized payload to stdout (token URLs
# are intentionally omitted from logs). To retrieve the verification URL locally,
# open the Inngest dev UI at http://localhost:8288, find the
# "notifications/email.requested" event, and read data.props.url from the
# event payload. CI/preview/prod: set to a Resend sandbox or production key.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev

# ──────────────── Phase 4 (Supabase Google OAuth — D-04 mandatory completion screen) ────────────────
# Local dev: leave empty unless testing OAuth path locally.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# ──────────────── Phase 4 review WR-08 — diagnostics gate (server-only) ────────────────
# Set to "1" only in CI/preview to enable /api/v1/diagnostics/iam-test-helpers/*
# and the (test)/modal-sheet page. NEVER set in production. Server-only flag —
# no NEXT_PUBLIC_ prefix means the value never enters the client bundle.
ENABLE_TEST_ROUTES=

# ──────────────── Phase 12 (deploy — 3 vars) — placeholders ────────────────
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
