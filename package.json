{
  "name": "folhario",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "prepare": "husky",
    "dev": "INNGEST_DEV=1 next dev",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "pnpm exec vitest --run --project=unit --project=unit-dom",
    "test:integration": "pnpm exec vitest --run --project=integration",
    "test:run": "pnpm test:unit && pnpm test:integration",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:sync-env": "bash scripts/sync-supabase-env.sh",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed && pnpm db:check-rls && pnpm db:check-seeds",
    "db:check-rls": "tsx --env-file-if-exists=.env.local scripts/check-rls.ts",
    "db:check-seeds": "tsx --env-file-if-exists=.env.local scripts/check-seeds.ts",
    "supabase": "supabase",
    "lint:styles": "stylelint 'src/**/*.css'",
    "icons:generate": "pwa-asset-generator public/brand/logo.svg public/icons --manifest public/manifest.webmanifest --background \"#FBF7EF\" --opaque false --maskable true --favicon --icon-only",
    "visual:baseline:docker": "docker run --rm -v $(pwd):/app -v folhario_docker_node_modules:/app/node_modules -v folhario_docker_next_cache:/app/.next -w /app mcr.microsoft.com/playwright:v1.59.1-jammy bash -lc 'corepack enable && corepack prepare pnpm@9.15.5 --activate && pnpm install --frozen-lockfile && pnpm build && npx playwright test --update-snapshots'",
    "visual:baseline:docker:check": "docker run --rm -v $(pwd):/app -v folhario_docker_node_modules:/app/node_modules -v folhario_docker_next_cache:/app/.next -w /app mcr.microsoft.com/playwright:v1.59.1-jammy bash -lc 'corepack enable && corepack prepare pnpm@9.15.5 --activate && pnpm install --frozen-lockfile && pnpm build && npx playwright test'"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-tabs": "1.1.13",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "10.48.0",
    "@serwist/next": "9.5.7",
    "@serwist/window": "9.5.7",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "2.104.1",
    "@tanstack/query-async-storage-persister": "^5.100.7",
    "@tanstack/react-query": "^5.100.7",
    "@tanstack/react-query-persist-client": "^5.100.7",
    "browser-image-compression": "2.0.2",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "exifr": "7.1.3",
    "idb-keyval": "^6.2.2",
    "inngest": "^4.2.4",
    "jose": "6.2.2",
    "lucide-react": "1.11.0",
    "motion": "12.38.0",
    "next": "16.2.3",
    "next-intl": "4.9.1",
    "postgres": "3.4.9",
    "posthog-js": "1.368.0",
    "posthog-node": "5.29.7",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "resend": "^6.12.2",
    "serwist": "9.5.7",
    "sharp": "0.34.5",
    "sonner": "2.0.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.2",
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/ui": "4.1.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-better-tailwindcss": "4.4.1",
    "fake-indexeddb": "^6.2.5",
    "husky": "9.1.7",
    "jsdom": "^29.1.0",
    "lint-staged": "16.4.0",
    "postcss": "8.5.12",
    "prettier": "3.8.3",
    "pwa-asset-generator": "8.1.4",
    "stylelint": "17.9.0",
    "stylelint-config-standard": "40.0.0",
    "supabase": "2.95.0",
    "tailwindcss": "4.2.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.4"
  }
}
