{
  "name": "folhario",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "pnpm exec vitest --run --project=unit",
    "test:integration": "pnpm exec vitest --run --project=integration",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:sync-env": "bash scripts/sync-supabase-env.sh",
    "supabase": "supabase"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@sentry/nextjs": "10.48.0",
    "@serwist/next": "9.5.7",
    "next": "16.2.3",
    "next-intl": "4.9.1",
    "posthog-js": "1.368.0",
    "posthog-node": "5.29.7",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "serwist": "9.5.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@playwright/test": "1.59.1",
    "@types/node": "22.19.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/ui": "4.1.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.3",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.8.3",
    "supabase": "2.95.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.4"
  }
}
